# ==============================================================================
# Configuração Multi-LLM para Ruadan + red-MPPO
# ==============================================================================

# Provedor ativo de LLM: ollama | google | openai | anthropic | deepseek | nvidia
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b

# ------------------------------------------------------------------------------
# 1. Provedor Local: Ollama
# ------------------------------------------------------------------------------
OLLAMA_API_BASE=http://localhost:11434/v1
# Modelos sugeridos: qwen3:8b, gpt-oss:20b, llama3.1:8b, deepseek-r1:8b

# ------------------------------------------------------------------------------
# 2. Provedor Google Gemini
# ------------------------------------------------------------------------------
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=
# Modelos sugeridos: gemini-2.5-pro, gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. Provedor OpenAI
# ------------------------------------------------------------------------------
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelos sugeridos: gpt-4o, gpt-4o-mini, o1, o3-mini

# ------------------------------------------------------------------------------
# 4. Provedor Anthropic Claude
# ------------------------------------------------------------------------------
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelos sugeridos: claude-3-7-sonnet-20250219, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022

# ------------------------------------------------------------------------------
# 5. Provedor DeepSeek
# ------------------------------------------------------------------------------
# Obtenha em: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# Modelos sugeridos: deepseek-chat, deepseek-reasoner

# ------------------------------------------------------------------------------
# 6. Provedor NVIDIA NIM (Modelos Gratuitos via Cloud API)
# ------------------------------------------------------------------------------
# Obtenha sua chave gratuita com 1000 créditos em: https://build.nvidia.com/
NVIDIA_API_KEY=
# Modelos sugeridos:
#   meta/llama-3.3-70b-instruct
#   meta/llama-3.1-8b-instruct
#   mistralai/mistral-large-2-instruct
#   nvidia/llama-3.1-nemotron-70b-instruct
#   deepseek-ai/deepseek-r1
